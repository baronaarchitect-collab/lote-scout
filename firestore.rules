rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer/escribir SUS propios datos
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /lots/{lotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
